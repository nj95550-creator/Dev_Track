# Template for Node startup configuration; root Compose settings are separate.
# Omitting external database settings selects the local persisted PGlite engine.
# Local quickstart: leave DATABASE_URL unset to use the embedded PostgreSQL engine.
# Its database is persisted in backend/data/devtrack. Never commit that folder.
# For a hosted/multi-process deployment, use an external PostgreSQL database.
# DATABASE_URL=postgresql://devtrack:choose_a_password@localhost:5432/devtrack
# DB_SSL=true

HOST=0.0.0.0
PORT=3000
APP_ORIGIN=http://localhost:4173
NODE_ENV=development
# Node dev launcher uses "node"; Docker uses "docker" automatically.
SESSION_NAMESPACE=node
AUTO_MIGRATE=true
SERVE_FRONTEND=true
# Enabled by default locally; production requires ENABLE_SWAGGER=true explicitly.
ENABLE_SWAGGER=true
# DATA_DIR=./data/devtrack
# Only enable when the API is accessible exclusively through a trusted proxy
# that overwrites X-Forwarded-For. Direct public access must be blocked.
TRUST_PROXY=false

# Optional SMTP transport for password recovery. Without it, recovery is hidden.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DevTrack <accounts@your-domain.example>
