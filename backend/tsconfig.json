// Backend compilation emits Node-compatible JavaScript into dist for startup.
// NodeNext follows backend/package.json's CommonJS mode and Node resolution.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    // Check application types strictly; third-party declaration internals are skipped.
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}