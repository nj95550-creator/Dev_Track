# Template for private Docker Compose settings. Copy to .env and replace the
# placeholder values locally; never commit the resulting credentials.
# Docker Compose settings (separate from backend/.env used by the Node quickstart).
# The Windows Docker launcher creates .env with a random password automatically.
# For manual startup, copy this to .env and choose a password before first launch.
DB_PASSWORD=replace-with-a-long-random-database-password
# Keep DB_PASSWORD unchanged when upgrading an existing Docker volume.
# Generate a second password; the app never receives the owner password.
APP_DB_USER=devtrack_app
APP_DB_PASSWORD=replace-with-a-separate-long-random-password
APP_PORT=3000
# Email password recovery (use your provider's real settings before public launch):
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DevTrack <accounts@your-domain.example>
# Production override only:
# APP_ORIGIN=https://your-domain.example
# ENABLE_SWAGGER=false
# TRUST_PROXY=false
